<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ConfigureLanPlay</class>
 <widget class="QWidget" name="ConfigureLanPlay">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>433</width>
    <height>240</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <property name="accessibleName">
   <string>LAN Play</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="lan_play_group">
     <property name="title">
      <string>LAN Play</string>
     </property>
     <layout class="QGridLayout" name="lan_play_layout">
      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="lan_play_enabled">
        <property name="text">
         <string>Join a switch-lan-play relay</string>
        </property>
        <property name="toolTip">
         <string>Makes the emulated console behave like a Switch connected to a switch-lan-play relay. No second PC, external client, virtual adapter or host routing change is needed. Games that support local wireless multiplayer can then see every other player on the same relay.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="lan_play_server_label">
        <property name="text">
         <string>Relay Server</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="lan_play_server">
        <property name="placeholderText">
         <string>host:port, for example switch.example.com:11451</string>
        </property>
        <property name="toolTip">
         <string>Address of the relay to join. The port defaults to 11451 when omitted. If the relay requires a login, use user:password@host:port.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QPushButton" name="lan_play_test">
        <property name="text">
         <string>Test</string>
        </property>
        <property name="toolTip">
         <string>Joins the relay without starting a game, sends the scan a console sends when it looks for a local session, and reports what answered. Use it to tell a wrong relay setting apart from a game specific problem.</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lan_play_virtual_ip_label">
        <property name="text">
         <string>Virtual IP</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="lan_play_virtual_ip">
        <property name="placeholderText">
         <string>Automatic</string>
        </property>
        <property name="toolTip">
         <string>Address the emulated console presents on the relay. Leave empty to pick one automatically inside 10.13.0.0/16. The host keeps its own address either way.</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="lan_play_ldn_mitm">
        <property name="text">
         <string>Use ldn_mitm for games without LAN Play support</string>
        </property>
        <property name="toolTip">
         <string>Carries local wireless (LDN) over the relay using the ldn_mitm protocol, which is what makes games that have no LAN mode of their own work over LAN Play. It is byte compatible with a real Switch running ldn_mitm, so consoles and other emulators on the same relay can join. Turn it off to leave the relay to the plain IP traffic of games that do have a LAN mode. Takes effect the next time a game enters its local multiplayer menu.</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="3">
       <widget class="QLabel" name="lan_play_test_result">
        <property name="text">
         <string/>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="textInteractionFlags">
         <set>Qt::TextInteractionFlag::TextSelectableByMouse</set>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
